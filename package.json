{
  "name": "grief-matters-cms",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler types && sanity dev",
    "worker-dev": "npm run build && npx wrangler dev",
    "start": "wrangler types && sanity start",
    "build": "wrangler types && sanity build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,tsx,css,json,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,css,json,md}'",
    "typecheck": "wrangler types && tsc --noEmit",
    "deploy": "npx sanity schema deploy && npx wrangler deploy"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "0.98.0",
    "@sanity/client": "7.22.0",
    "@sanity/icons": "3.7.4",
    "@sanity/ui": "3.2.0",
    "@sanity/vision": "5.27.0",
    "groq": "5.27.0",
    "itty-router": "5.0.23",
    "lodash": "4.18.1",
    "pluralize": "8.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-is": "19.2.6",
    "react-markdown": "10.1.0",
    "react-time-picker": "8.0.2",
    "remark-gfm": "4.0.1",
    "robots-parser": "3.0.1",
    "sanity": "5.27.0",
    "sanity-plugin-utils": "1.8.0",
    "styled-components": "6.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sanity/cli": "6.6.0",
    "@types/lodash": "4.17.24",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.2.15",
    "@types/node": "25.9.1",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.8.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.60.0",
    "wrangler": "4.95.0"
  }
}
